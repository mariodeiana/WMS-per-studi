[Unit]
Description=AS Consulting WMS Management Console
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=ascadmin
Group=ascadmin
SupplementaryGroups=docker
WorkingDirectory=/opt/asc/wms/management
ExecStart=/usr/bin/python3 /opt/asc/wms/management/management.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
